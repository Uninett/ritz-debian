    set chan $ServerChan
    safePuts $chan [format "pollintf %s %s" $router $intf]
    safeGets $chan l
    if {! [regexp "^200 " $l]} {
	error [format "error polling interface %s / %s: %s" \
		$router $intf $l]
    }
}

proc clearFlap { router intf } {
    global ServerChan

    set chan $ServerChan
    safePuts $chan [format "clearflap %s %s" $router $intf]
    safeGets $chan l
    if {! [regexp "^200 " $l]} {
	error [format "error clearing flap %s / %s: %s" \
