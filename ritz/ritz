    }
    set w .edit-selected
    uiSimpleToplevelSetup $w [format "Edit selected cases"]
    wm geometry $w 80x5
    frame $w.f
    set id [lindex [array names Selected] 0]; # Need to pick one
    uiModHistSetup $w.f $id uiSendSelectedHistAndState
    pack $w.f -side top
