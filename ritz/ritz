    set text [uiSimpleScrolledText $w 20 80]
    $text configure -state disabled

    update idletasks

    set agentArgs [list \
	    -address $addr \
	    -community $comm]

    netstat $agentArgs {noTranslation ciscoDescr} \
	    [list uiAppendTextLine $text]
}

