# TCL sub-script, configuration

# $Id$

# 15 minutes:
set period [expr 15 * 60000]
# 5 minutes (gross inaccuracy, but what the heck...)
set uptimeSlop [expr 100 * 60 * 5]

set top "/log-public/a/snmp"
set vtop [format "%s/ver-watch" $top]
set tltop [format "%s/logs/today" $vtop]

set logFile [format "%s/ver-watch.log" $tltop]
set confFile [format "%s/ifs.cf" $top]

set rtr_descr_dir [format "%s/descs" $tltop]

