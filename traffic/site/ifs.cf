interval 15;
default-community public;
logdir /archive/traffic/data/today;

router nord-gw {
  polladdr 192.36.148.33;
};

router syd-gw {
  polladdr 192.36.148.37;
};

router icm-gw {
  polladdr 192.36.148.193;
};

router upper-gw {
  polladdr 192.36.148.196;
};

router lower-gw {
  polladdr 192.36.148.197;
};

router east-gw {
  polladdr 192.36.148.199;
};

router triangle {
  polladdr 192.36.148.201;
};

router icm-kth-11 {
  polladdr 198.67.142.33;
  interval 3;
};

router is-gw {
  polladdr 192.36.148.130;
};

router se-ten34 {
  polladdr 192.36.148.200;
};
