# List of routers to monitor
# Comments start in coloumn zero
# Remember: only a single space between attribute name and value,
# and no blank line before global defaults
#
default interval: 15
default community: public
default domain: uninett.no

# highest-priority (backbone) routers first
name: no-gw2
address: 128.39.0.84
domain: nordu.net
priority: 500

